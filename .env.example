# =============================================================================
# Amazon Sales Dataset Pipeline — environment-variable template
# -----------------------------------------------------------------------------
# The pipeline is fully OFFLINE: it needs NO API keys to run. This template
# exists so that future integrations (Kaggle download, dashboards, LLM-based
# enrichment) can consume secrets safely from day one.
#
# Usage:
#   1. cp .env.example .env          (never commit the real .env — see .gitignore)
#   2. Fill in the values you actually need.
#   3. Load with python-dotenv:      from dotenv import load_dotenv; load_dotenv()
#      or read os.environ directly in your shell of choice.
# =============================================================================

# --- Kaggle dataset download (optional; module #1 reads a local amazon.csv) --
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Generic integration hooks (left blank on purpose) -----------------------
# EXTERNAL_API_BASE_URL=
# EXTERNAL_API_TOKEN=
